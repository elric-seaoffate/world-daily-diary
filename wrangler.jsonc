{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-daily-diary",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  
  "triggers": {
    "crons": ["0 * * * *"]
  },
  
  "vars": {
    "BOOKSTACK_URL": "https://notes.seaoffate.net",
    "MASTER_BOOK_ID": "317",
    "SYSTEM_TIMEZONE": "Europe/London"
  },
  
  "workflows": [
    {
      "name": "news-pipeline-workflow",
      "binding": "NEWS_WORKFLOW",
      "class_name": "NewsPipelineWorkflow"
    }
  ],
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-diary-db",
      "database_id": "d4286300-9f28-454c-85a2-75f5d05f1f4a"
    }
  ],
  
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "news-diary-archive"
    }
  ],
  
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "29ae240f56cb4e488ec18973b026c1cf"
    },
    {
      "binding": "OPERATIONAL_KV",
      "id": "60f4583fda5642e28295f49594ef3afd"
    }
  ],
  
  "ai": {
    "binding": "AI"
  }
}
